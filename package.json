{
  "name": "gadiruta-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "npm run typecheck && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "data": "node --experimental-strip-types scripts/network/build.ts",
    "data:refresh": "npm run data -- --download --current-and-next-year",
    "locations:probe": "node --experimental-strip-types scripts/location-research/probe-ctan-locations.ts",
    "locations:coordinates": "node --experimental-strip-types scripts/location-research/derive-location-coordinates.ts",
    "test": "node --experimental-strip-types --test --test-isolation=none \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.41.0",
    "motion": "^13.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "yauzl": "^3.4.0"
  }
}
